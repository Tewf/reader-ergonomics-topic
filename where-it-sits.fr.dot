  OT [label=<<b>reader-ergonomics-academic, -presentations,</b><br/><font point-size="11" color="#55575F">-software-design, autres projets</font><br/><font point-size="11" color="#55575F">niveau 2</font>>, fillcolor="#E6F2EA", color="#2E7D4F", style="rounded,filled,dashed"];
  TO [label=<<b>reader-ergonomics-topic</b><br/><font point-size="11" color="#55575F">une forme de topic, imbriquée à toute</font><br/><font point-size="11" color="#55575F">profondeur, sa revue et sa vérification</font><br/><font point-size="11" color="#55575F">niveau 1</font>>, fillcolor="#FBEDE4", color="#B4541A", penwidth=2.6];
